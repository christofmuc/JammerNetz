{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PackerReadEc2Configuration",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeRegions",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSnapshots",
        "ec2:DescribeSubnets",
        "ec2:DescribeTags",
        "ec2:DescribeVolumes",
        "ec2:DescribeVpcs"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PackerBuildEc2Image",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:CreateImage",
        "ec2:CreateKeyPair",
        "ec2:CreateSecurityGroup",
        "ec2:CreateTags",
        "ec2:DeleteKeyPair",
        "ec2:DeleteSecurityGroup",
        "ec2:RunInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PackerSetImdsV2OnCreatedImage",
      "Effect": "Allow",
      "Action": "ec2:ModifyImageAttribute",
      "Resource": "arn:aws:ec2:*::image/ami-*",
      "Condition": {
        "StringEquals": {
          "ec2:Attribute/ImdsSupport": "v2.0",
          "ec2:ResourceTag/Application": "JammerNetzServer",
          "ec2:ResourceTag/ManagedBy": "Packer"
        }
      }
    },
    {
      "Sid": "PackerCleanUpCreatedImages",
      "Effect": "Allow",
      "Action": "ec2:DeregisterImage",
      "Resource": "arn:aws:ec2:*::image/ami-*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Application": "JammerNetzServer",
          "ec2:ResourceTag/ManagedBy": "Packer"
        }
      }
    },
    {
      "Sid": "PackerCleanUpCreatedSnapshots",
      "Effect": "Allow",
      "Action": "ec2:DeleteSnapshot",
      "Resource": "arn:aws:ec2:*:*:snapshot/snap-*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Application": "JammerNetzServer",
          "ec2:ResourceTag/ManagedBy": "Packer"
        }
      }
    }
  ]
}
